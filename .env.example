# Groq — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Local Chroma vector store (no external key needed)
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=medical-bot

# Langfuse tracing (optional — omit to run untraced)
# Local stack: docker compose up in the langfuse/ folder, then create a
# project at http://localhost:3000 and paste its keys below.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
